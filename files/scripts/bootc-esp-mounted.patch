+/// Honor an ESP explicitly mounted by the installer before scanning the disk.
+/// This keeps a pre-existing Windows ESP out of an alongside installation.
+fn install_esp_device(root_setup: &RootSetup) -> Result<String> {
+    if root_setup.physical_root.is_mountpoint("boot/efi")? == Some(true) {
+        let path = root_setup.physical_root_path.join("boot/efi");
+        let mounted = bootc_mount::inspect_filesystem(&path)?;
+        if mounted.fstype != "vfat" {
+            bail!("The explicitly mounted ESP must be a FAT filesystem");
+        }
+        return Ok(mounted.source.to_string());
+    }
+    Ok(root_setup.device_info.find_first_colocated_esp()?.path())
+}
