#!/usr/bin/env bash
# Galería para las pruebas en QEMU (ci/iso-test.sh), solo con antu.galeria en la línea del kernel: abre una a una las
# pantallas principales en la sesión en vivo y avisa por la consola serie cuál está a la vista, para fotografiarla.
serie() { echo "ANTU-GALERIA: $1" > /dev/ttyS0; }
# Dentro de la sesión de Plasma del usuario en vivo, con su mismo entorno.
en_sesion() { systemd-run --user --machine=antu@ --collect --quiet -- "$@"; }
plasma() {
    en_sesion gdbus call --session --dest org.kde.plasmashell --object-path /PlasmaShell \
        --method "org.kde.PlasmaShell.$1" > /dev/null
}

until pgrep -u antu -x plasmashell > /dev/null; do sleep 2; done
sleep 25
pkill -f instalador.py
sleep 4
serie escritorio
sleep 10

plasma activateLauncherMenu
sleep 5
serie menu
sleep 10
plasma activateLauncherMenu

en_sesion systemsettings kcm_kscreen
sleep 25
serie pantalla
sleep 10
pkill -x systemsettings

en_sesion systemsettings kcm_pulseaudio
sleep 15
serie sonido
sleep 10
pkill -x systemsettings

en_sesion systemsettings kcm_bluetooth
sleep 15
serie bluetooth
sleep 10
pkill -x systemsettings

en_sesion dolphin /usr/share/wallpapers
sleep 10
serie dolphin
sleep 10
pkill -x dolphin

en_sesion /usr/lib/antu/zenit/app.py
sleep 10
serie zenit
sleep 10

en_sesion /usr/lib/antu/informe/informe.py
sleep 10
serie informe
sleep 10
pkill -f informe.py

# Sin internet en esta prueba: se ve cómo lo avisa. Con conexión se probó aparte; aquí importa que abra y no falle.
en_sesion /usr/lib/antu/biblioteca/biblioteca.py
sleep 12
serie biblioteca
sleep 10
pkill -f biblioteca.py

# GameMode sin comandos: un juego de mentira, que Zenit detecta por su carpeta y le pide a GameMode.
mkdir -p /var/tmp/steamapps/common/JuegoDePrueba
cp /usr/bin/sleep /var/tmp/steamapps/common/JuegoDePrueba/juego
en_sesion /var/tmp/steamapps/common/JuegoDePrueba/juego 40
sleep 15
serie "gamemode $(systemd-run --user --machine=antu@ --wait --pipe --quiet gamemoded -s 2>&1)"

# El Observatorio midió ese juego solo: cuando termina, queda su sesión.
sleep 35
serie "observatorio $(tail -n 1 "$(getent passwd antu | cut -d: -f6)/.local/share/antu/observatorio/sesiones.jsonl" 2>&1)"
en_sesion /usr/lib/antu/observatorio/observatorio.py
sleep 10
serie observatorio-ventana
sleep 10
pkill -f observatorio.py

# El informe de verdad, con su limpieza y su guardado en el USB; se copia a la consola para revisarlo.
resultado="$(echo "(creado por la prueba)" | /usr/lib/antu/informe-helper)"
serie "informe-resultado $resultado"
copia="$(echo "$resultado" | python3 -c 'import json, sys; print(json.load(sys.stdin)["copia"])')"
{ echo ANTU-INFORME-INICIO; cat "$copia"; echo ANTU-INFORME-FIN; } > /dev/ttyS0

en_sesion gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications \
    --method org.freedesktop.Notifications.Notify "Antu" 0 "antu" "Actualización de Antu lista" \
    "Se aplica la próxima vez que reinicies." "[]" "{}" 15000
sleep 4
serie notificacion
sleep 10

# Al final: una vez bloqueada, la sesión ya no deja ver nada más.
loginctl lock-sessions
sleep 6
serie bloqueo
sleep 10
serie fin

/usr/lib/antu/live/prueba-eclipse antu
