#!/bin/sh
# Prueba de ci/iso-test.sh (paso 5) en el sistema instalado, con internet: que un programa sin privilegios tenga red, que
# se acepte una actualización firmada con la llave de Antu y que se rechace una versión antigua, sin esa firma. Solo
# existe en el disco de esa prueba: la copia ahí prueba-instalar.
aviso() { echo "ANTU-FIRMA: $*" > /dev/ttyS0; }

for _ in $(seq 40); do getent hosts ghcr.io > /dev/null && break; sleep 3; done
getent hosts ghcr.io > /dev/null || { aviso "sin red"; exit 0; }

if setpriv --reuid=65534 --regid=65534 --clear-groups sh -c 'cat /etc/resolv.conf > /dev/null && curl -fsS -o /dev/null https://flathub.org/'; then
    aviso "internet OK"
else
    aviso "internet FALLO"
fi

if salida="$(bootc upgrade --check 2>&1)"; then
    aviso "actualizar OK"
else
    aviso "actualizar FALLO: $(echo "$salida" | tail -n 2 | tr '\n' ' ')"
fi

if salida="$(bootc switch --transport registry ghcr.io/bernaljeanp/antu-nvidia:20261101 2>&1)"; then
    aviso "sin firma ACEPTADA"
elif echo "$salida" | grep -qi "signature"; then
    aviso "sin firma RECHAZADA"
else
    aviso "sin firma OTRO ERROR: $(echo "$salida" | tail -n 2 | tr '\n' ' ')"
fi
aviso fin

# El viaje a Eclipse con una cuenta como las que crea Inicio (systemd-homed): con ella se decide si la vuelta pide contraseña.
NEWPASSWORD=prueba-eclipse homectl create prueba --real-name=Prueba --member-of=wheel \
    --storage=directory --enforce-password-policy=no
PASSWORD=prueba-eclipse homectl activate prueba
rm -f /etc/sddm.conf.d/90-antu-inicio.conf
printf '[Autologin]
User=prueba
Session=plasma.desktop
Relogin=false
' > /etc/sddm.conf.d/50-prueba.conf
systemctl restart display-manager
for _ in $(seq 60); do pgrep -u prueba -x plasmashell > /dev/null && break; sleep 3; done
rm -f /etc/sddm.conf.d/50-prueba.conf
sleep 30  # Plasma terminando de abrir
/etc/antu-prueba-eclipse prueba
