#!/usr/bin/env bash
# Prueba automática del instalador en QEMU (ci/iso-test.sh): instala en el disco de antu.prueba-instalar=DISCO,
# informa por la consola y apaga el equipo. El sistema instalado escribe su arranque en la consola serie para que
# la prueba sepa si llegó a la pantalla gráfica: systemd escribe directo en la consola (log_target), y su línea
# «Startup finished» sale cuando terminó de arrancar todo, también con el inicio de sesión de esa consola ya abierto.
dev="$(sed -n 's/.*antu\.prueba-instalar=\([^ ]*\).*/\1/p' /proc/cmdline)"
huella="$(lsblk -bdno SERIAL,SIZE "$dev" | xargs)"
if ANTU_KARGS="console=ttyS0,115200 systemd.show_status=1 systemd.log_target=console" \
    /usr/lib/antu/instalador-helper instalar "$dev" "$huella"; then
    # Deja en el disco de la prueba el paso 5 de ci/iso-test.sh (firmas e internet), que corre al arrancar.
    punto="$(mktemp -d)"
    mount "$(lsblk -nrpo PATH,LABEL "$dev" | awk '$2 == "root" {print $1}')" "$punto"
    etc="$(echo "$punto"/state/deploy/*/etc)"
    [ -d "$etc/upper" ] && etc="$etc/upper"
    mkdir -p "$etc/systemd/system/multi-user.target.wants"
    cp /usr/lib/antu/live/prueba-firma "$etc/antu-prueba-firma"
    cp /usr/lib/antu/live/prueba-eclipse "$etc/antu-prueba-eclipse"
    printf '[Unit]\nDescription=Prueba de firmas e internet\nConditionPathExists=/dev/ttyS0\n[Service]\nType=exec\nExecStart=/etc/antu-prueba-firma\n' \
        > "$etc/systemd/system/antu-prueba-firma.service"
    ln -s ../antu-prueba-firma.service "$etc/systemd/system/multi-user.target.wants/antu-prueba-firma.service"
    umount "$punto"
    echo "ANTU-INSTALAR: OK"
else
    echo "ANTU-INSTALAR: FALLO"
fi
systemctl poweroff
