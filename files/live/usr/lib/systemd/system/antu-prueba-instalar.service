[Unit]
Description=Prueba automática del instalador de Antu (solo con antu.prueba-instalar= en la línea del kernel)
ConditionKernelCommandLine=antu.prueba-instalar
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/lib/antu/live/prueba-instalar
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
