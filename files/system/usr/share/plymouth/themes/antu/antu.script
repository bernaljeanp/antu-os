# Antu OS: identidad tranquila y progreso comunicado por Plymouth.
# Se reutiliza el arte aprobado. No hay consola ficticia, parpadeos ni espera artificial.
Window.SetBackgroundTopColor(20 / 255, 20 / 255, 24 / 255);
Window.SetBackgroundBottomColor(20 / 255, 20 / 255, 24 / 255);
W = Window.GetWidth();
H = Window.GetHeight();
F = H / 1600;
CX = W / 2;
CY = H * 0.40;
ARRANQUE = (Plymouth.GetMode() == "boot");
Z = Math.Int(240 * F);
if (Z < 96) Z = 96;
simbolo = Sprite(Image("simbolo.png").Scale(Z, Z));
simbolo.SetPosition(Math.Int(CX - Z / 2), Math.Int(CY - Z / 2), 6);
titulo_src = Image("titulo-estatico-2x.png");
titulo_img = titulo_src.Scale(Math.Int(titulo_src.GetWidth() * F / 2), Math.Int(titulo_src.GetHeight() * F / 2));
titulo = Sprite(titulo_img);
titulo.SetPosition(Math.Int(CX - titulo_img.GetWidth() / 2), Math.Int(CY + 150 * F), 6);
if (ARRANQUE) {
    bar_w = Math.Int(H * 0.22);
    bar_h = Math.Int(6 * F);
    if (bar_h < 3) bar_h = 3;
    bar_x = Math.Int((W - bar_w) / 2);
    bar_y = Math.Int(CY + 330 * F);
    track = Sprite(Image("track.png").Scale(bar_w, bar_h));
    track.SetPosition(bar_x, bar_y, 7);
    fill_src = Image("fill.png");
    fill = Sprite();
    fill.SetPosition(bar_x, bar_y, 8);
}
fun progress_callback(duration, progress) {
    if (global.ARRANQUE) {
        w = Math.Int(global.bar_w * progress);
        if (w > global.bar_w) w = global.bar_w;
        if (w < 1) global.fill.SetOpacity(0);
        else {
            global.fill.SetImage(global.fill_src.Scale(w, global.bar_h));
            global.fill.SetOpacity(1);
        }
    }
}
Plymouth.SetBootProgressFunction(progress_callback);

# Mensajes del sistema (por ejemplo, revisión de disco): una línea discreta bajo la barra.
message = Sprite();
fun message_callback(text) {
    img = Image.Text(text, 0.78, 0.78, 0.80);
    global.message.SetImage(img);
    global.message.SetPosition(Math.Int((global.W - img.GetWidth()) / 2), Math.Int(global.CY + 410 * global.F), 9);
}
Plymouth.SetMessageFunction(message_callback);

# Contraseña de disco cifrado: indicación y puntos bajo la barra.
prompt = Sprite();
bullets = Sprite();
fun password_callback(text, count) {
    prompt_img = Image.Text(text, 0.96, 0.96, 0.97);
    global.prompt.SetImage(prompt_img);
    global.prompt.SetPosition(Math.Int((global.W - prompt_img.GetWidth()) / 2), Math.Int(global.CY + 410 * global.F), 9);
    dots = "";
    for (i = 0; i < count; i++) dots = dots + "•";
    dots_img = Image.Text(dots, 0.96, 0.96, 0.97);
    global.bullets.SetImage(dots_img);
    global.bullets.SetPosition(Math.Int((global.W - dots_img.GetWidth()) / 2), Math.Int(global.CY + 470 * global.F), 9);
    global.prompt.SetOpacity(1);
    global.bullets.SetOpacity(1);
}
fun normal_callback() {
    global.prompt.SetOpacity(0);
    global.bullets.SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(password_callback);
Plymouth.SetDisplayNormalFunction(normal_callback);
