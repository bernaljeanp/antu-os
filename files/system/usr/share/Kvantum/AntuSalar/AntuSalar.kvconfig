[%General]
author=Antu OS
comment=Grafito mate, canto satinado y acentos lava. Arte original.
respect_DE=true
composite=false
translucent_windows=false
blurring=false
popup_blurring=false
remove_extra_frames=true
small_icon_size=22
large_icon_size=32
scrollbar_width=12
check_size=20
radio_size=20
layout_spacing=8
layout_margin=12
button_contents_shift=true
button_default_indicator=true
combo_focus_rect=true
x11drag=menubar_and_primary_toolbar

[GeneralColors]
window.color=#F5F5F7
base.color=#FFFFFF
alt.base.color=#EDEDF1
button.color=#FFFFFF
text.color=#1D1D1F
window.text.color=#1D1D1F
button.text.color=#1D1D1F
disabled.text.color=#5E5E64
highlight.color=#B3340D
highlight.text.color=#FFFFFF
link.color=#AE330C
tooltip.base.color=#FFFFFF
tooltip.text.color=#1D1D1F

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=8
frame.bottom=8
frame.left=8
frame.right=8
interior=true
interior.element=button
text.margin.top=4
text.margin.bottom=4
text.margin.left=8
text.margin.right=8
text.normal.color=#1D1D1F
text.focus.color=#1D1D1F
text.press.color=#FFFFFF
text.toggle.color=#FFFFFF
text.shadow=false
indicator.element=arrow
indicator.size=16

