[kdeglobals][KDE]
widgetStyle=kvantum

[kdeglobals][General]
ColorScheme=AntuObsidiana

[kdeglobals][Icons]
Theme=Antu

[plasmarc][Theme]
name=antu

[kcminputrc][Mouse]
cursorTheme=Antu-Cursores

[kwinrc][org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze
ButtonsOnLeft=
ButtonsOnRight=IAX

[Wallpaper]
Image=Paranal

# Vidrio: menús de las apps translúcidos y un desenfoque más esmerilado detrás de la barra y los menús.
[breezerc][Style]
MenuOpacity=94

[kwinrc][Effect-blur]
BlurStrength=8
NoiseStrength=3

# Ventanas: esquinas redondas arriba y abajo (KWin), contorno fino sobre el fondo oscuro y una sombra amplia y
# suave como en macOS. Título al centro y solo minimizar, maximizar y cerrar, a la derecha.
[breezerc][Common]
RoundedCorners=true
OutlineEnabled=true
ShadowSize=ShadowLarge
ShadowStrength=160

[breezerc][Windeco]
TitleAlignment=AlignCenterFullWidth
ButtonSize=ButtonDefault

# Pantalla de carga de la sesión: la misma para las dos distribuciones.
[ksplashrc][KSplash]
Theme=org.antuos.desktop
