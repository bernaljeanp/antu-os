[kdeglobals][KDE]
widgetStyle=Breeze

[kdeglobals][General]
ColorScheme=AntuObsidiana

[kdeglobals][Icons]
Theme=Antu

[plasmarc][Theme]
name=antu

[kcminputrc][Mouse]
cursorTheme=breeze_cursors

[kwinrc][org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze
ButtonsOnLeft=
ButtonsOnRight=IAX

[Wallpaper]
Image=Antu

# Vidrio: menús de las apps translúcidos y un desenfoque más esmerilado detrás de la barra y los menús.
[breezerc][Style]
MenuOpacity=82

[kwinrc][Effect-blur]
BlurStrength=8
NoiseStrength=3

# Ventanas: esquinas redondas arriba y abajo (KWin), contorno fino sobre el fondo oscuro y una sombra amplia y
# suave como en macOS. Título al centro y solo minimizar, maximizar y cerrar, a la derecha.
[breezerc][Common]
RoundedCorners=true
OutlineEnabled=true
ShadowSize=ShadowVeryLarge
ShadowStrength=210

[breezerc][Windeco]
TitleAlignment=AlignCenterFullWidth
ButtonSize=ButtonDefault
