#!/usr/bin/env bash
# Entra al modo Eclipse desde el escritorio: avisa, deja listo el cambio y cierra la sesión de Plasma.
kdialog --title "Modo Eclipse" --continue-label "Entrar a Eclipse" --warningcontinuecancel \
    "Steam se abrirá a pantalla completa y se cerrarán las ventanas del escritorio. Guarda lo que tengas abierto.<br><br>Al salir de Steam, vuelves aquí." \
    || exit 0
pkexec /usr/lib/antu/eclipse-helper eclipse \
    && exec gdbus call --session --dest org.kde.Shutdown --object-path /Shutdown --method org.kde.Shutdown.logout
