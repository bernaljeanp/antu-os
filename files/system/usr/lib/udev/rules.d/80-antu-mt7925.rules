# Solo el Bluetooth Foxconn/MediaTek MT7925 del equipo probado. Mantenerlo despierto durante la configuración evita
# una suspensión USB a mitad de una orden WMT. No cambia el ahorro de energía de otros dispositivos ni del wifi.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0489", ATTR{idProduct}=="e139", TEST=="power/control", ATTR{power/control}="on"
