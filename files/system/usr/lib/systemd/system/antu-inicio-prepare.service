[Unit]
Description=Prepara Inicio, el asistente gráfico del primer arranque de Antu
Before=display-manager.service
After=systemd-homed.service systemd-sysusers.service

[Service]
Type=oneshot
# Sin cuentas todavía: entra solo a Inicio. Con una cuenta ya creada: quita ese autologin (ver inicio-helper preparar).
ExecStart=/usr/lib/antu/inicio-helper preparar

[Install]
WantedBy=multi-user.target
