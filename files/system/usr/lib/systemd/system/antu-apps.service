[Unit]
Description=Prepara el navegador de Antu desde Flathub; las demás apps se eligen en Centro de Antu
After=network.target
ConditionPathExists=!/var/lib/antu/apps-v2

# En segundo plano (Type=exec): el arranque no espera las descargas. La marca de listo se escribe solo si la
# instalación termina bien; sin internet, lo vuelve a intentar cada minuto.
[Service]
Type=exec
# Solo el navegador por defecto. El resto se selecciona en Centro de Antu sin bloquear el escritorio.
ExecStart=/usr/lib/antu/preparar-helper predeterminadas
Restart=on-failure
RestartSec=60
# Protección básica que no estorba a bootc ni a Flatpak (ni ProtectSystem ni PrivateTmp: los dos escriben fuera).
NoNewPrivileges=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
