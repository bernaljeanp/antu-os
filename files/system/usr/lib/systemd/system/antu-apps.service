[Unit]
Description=Instala las apps de Antu desde Flathub en el primer arranque con internet
After=network.target
ConditionPathExists=!/var/lib/antu/apps-v1

# En segundo plano (Type=exec): el arranque no espera las descargas. La marca de listo se escribe solo si la
# instalación termina bien; sin internet, lo vuelve a intentar cada minuto.
[Service]
Type=exec
ExecStartPre=/usr/bin/flatpak remote-add --system --if-not-exists flathub /etc/flatpak/remotes.d/flathub.flatpakrepo
# Navegador; juegos (Heroic, Lutris, Bottles, ProtonPlus, Discord, Sober para Roblox); básicos (VLC, Mission Center,
# OBS Studio) y EasyEffects, que reemplaza el ajuste de sonido Dolby de Windows.
ExecStart=/bin/sh -c 'flatpak install --system --noninteractive --or-update flathub \
    com.brave.Browser \
    com.heroicgameslauncher.hgl net.lutris.Lutris com.usebottles.bottles com.vysp3r.ProtonPlus \
    com.discordapp.Discord org.vinegarhq.Sober \
    org.videolan.VLC io.missioncenter.MissionCenter com.obsproject.Studio com.github.wwmm.easyeffects \
    && mkdir -p /var/lib/antu && touch /var/lib/antu/apps-v1'
Restart=on-failure
RestartSec=60
# Protección básica que no estorba a bootc ni a Flatpak (ni ProtectSystem ni PrivateTmp: los dos escriben fuera).
NoNewPrivileges=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
