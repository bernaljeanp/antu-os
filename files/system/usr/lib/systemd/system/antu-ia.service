[Unit]
Description=Instala la IA local (Alpaca con Ollama) pedida en Inicio
After=network.target
ConditionPathExists=/var/lib/antu/ia-solicitada
ConditionPathExists=!/var/lib/antu/ia-instalada

# En segundo plano, como antu-apps: el arranque no espera la descarga de varios GB.
[Service]
Type=exec
ExecStartPre=/usr/bin/flatpak remote-add --system --if-not-exists flathub /etc/flatpak/remotes.d/flathub.flatpakrepo
ExecStart=/bin/sh -c 'flatpak install --system --noninteractive --or-update flathub \
    com.jeffser.Alpaca com.jeffser.Alpaca.Plugins.Ollama && touch /var/lib/antu/ia-instalada'
Restart=on-failure
RestartSec=120
# Protección básica que no estorba a bootc ni a Flatpak (ni ProtectSystem ni PrivateTmp: los dos escriben fuera).
NoNewPrivileges=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
