[Unit]
Description=Instala WordCraft, DeckCraft, GridCraft y PdfCraft (ArtCraft) en el primer arranque con internet
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/antu/craft-apps-v1

# El repositorio de ArtCraft está en vista previa sin firma (GPGVerify=false): por eso sus apps entran como
# Flatpak aislados y no como paquetes del sistema base. Unidad aparte de antu-apps para que un fallo de ArtCraft
# no bloquee el resto.
[Service]
Type=oneshot
ExecStartPre=/usr/bin/flatpak remote-add --system --if-not-exists artcraft-oci /usr/share/antu/artcraft-oci.flatpakrepo
ExecStart=/usr/bin/flatpak install --system --noninteractive --or-update artcraft-oci ai.storyteller.wordcraft ai.storyteller.deckcraft ai.storyteller.gridcraft ai.storyteller.pdfcraft
ExecStartPost=/usr/bin/mkdir -p /var/lib/antu
ExecStartPost=/usr/bin/touch /var/lib/antu/craft-apps-v1
Restart=on-failure
RestartSec=120

[Install]
WantedBy=multi-user.target
